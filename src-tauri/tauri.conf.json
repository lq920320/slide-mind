{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SlideMind",
  "version": "0.1.0",
  "identifier": "com.lq920320.slidemind",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SlideMind",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCNTcwNTFGQjhFODRFNjIKUldSaVR1aTRId1ZYYS9SRFo2eGR2OTAzakpXVG1VRk9vR0lkNC94NXNBdkNMTGhvVWwwTDZrT1QK",
      "endpoints": ["https://github.com/lq920320/slide-mind/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": ["smind"],
        "name": "SlideMind Document",
        "description": "SlideMind mind map & slides document",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
